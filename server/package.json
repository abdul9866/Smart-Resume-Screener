{
  "name": "smart-resume-screener-server",
  "version": "1.0.0",
  "description": "Backend API for Smart Resume Screener",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate --schema=../prisma/schema.prisma && prisma db push --schema=../prisma/schema.prisma --accept-data-loss && tsx ../prisma/seed.ts && rimraf dist && tsc",
    "start": "node dist/app.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.33.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.12.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
